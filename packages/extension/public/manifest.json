{
  "manifest_version": 3,
  "name": "Deeporax Browser MCP",
  "version": "0.1.21",
  "description": "Let AI agents see and control this browser: DOM snapshots, screenshots, clicks, typing, navigation, console and network.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Deeporax Browser MCP",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "alarms",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
